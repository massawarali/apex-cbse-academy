                    <h3 class="text-2xl font-extrabold text-slate-900 mb-2">Quick Inquiry Form</h3>
                    <p class="text-slate-500 text-sm mb-6">Fill out the details below to send an instant inquiry on WhatsApp.</p>

                    <form id="demoForm" onsubmit="sendToWhatsApp(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Student's Full Name *</label>
                            <input type="text" id="studentName" required placeholder="Enter student name" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 text-sm">
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Select Class *</label>
                                <select id="studentClass" required class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 text-sm bg-white">
                                    <option value="Class 6">Class 6 (3:30 - 5:30 PM)</option>
                                    <option value="Class 7">Class 7 (3:30 - 5:30 PM)</option>
                                    <option value="Class 8">Class 8 (3:30 - 5:30 PM)</option>
                                    <option value="Class 9">Class 9 (5:30 - 7:30 PM)</option>
                                    <option value="Class 10">Class 10 (5:30 - 7:30 PM)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Parent's Mobile *</label>
                                <input type="tel" id="parentPhone" required placeholder="10-digit mobile number" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 text-sm">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">School Name (Optional)</label>
                            <input type="text" id="schoolName" placeholder="Current CBSE School Name" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 text-sm">
                        </div>

                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-base">
                            <i class="fab fa-whatsapp text-xl"></i> Book Demo via WhatsApp
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-400 py-8 text-center text-sm border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4">
            <p class="font-bold text-white text-base mb-1">Apex CBSE Academy</p>
            <p class="text-xs text-slate-500 mb-4">Building Strong Concepts, Shaping Bright Futures</p>
            <p>&copy; 2026 Apex CBSE Academy. All Rights Reserved.</p>
        </div>
    </footer>

    <!-- WhatsApp Form Script -->
    <script>
        function sendToWhatsApp(event) {
            event.preventDefault();
            // Apna 10-digit WhatsApp number niche '91' ke baad daalein
            const coachingWhatsAppNumber = "9337042839";

            const name = document.getElementById('studentName').value;
            const studentClass = document.getElementById('studentClass').value;
            const phone = document.getElementById('parentPhone').value;
            const school = document.getElementById('schoolName').value || "Not mentioned";

            const message = `Hello *Apex CBSE Academy*!%0A%0AI want to book a *Free Demo Class*:%0A*Student Name:* ${name}%0A*Class:* ${studentClass}%0A*Parent Mobile:* ${phone}%0A*School:* ${school}`;

            const whatsappURL = `https://wa.me/${coachingWhatsAppNumber}?text=${message}`;
            window.open(whatsappURL, '_blank');
        }
    </script>
